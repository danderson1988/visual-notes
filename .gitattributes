# The vendored type definitions under types/ are compared against the copies
# npm installs (see test/vendored-types.test.ts), and npm tarballs ship LF.
# Without this, a clone on Windows with core.autocrlf=true would check them out
# as CRLF and the comparison would fail for reasons that have nothing to do
# with the declarations having changed.
types/**/*.d.ts -text
